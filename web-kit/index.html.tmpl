<!DOCTYPE html>
<html lang="en">
<head>
  <base href="$FLUTTER_BASE_HREF">
  <meta charset="UTF-8">
  <!--
    Zero-Trust web kit. Generated by tool/apply_web_kit.sh in the
    Zero-Trust-Core repository: change the kit there, not this copy.

    The policy below is the app's safety net in a browser. Scripts run only
    from this site (plus WebAssembly for the encrypted database and the
    renderer), and the page may only talk to this site and the account
    server. Nothing loads from a CDN or any third party.
  -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:@ZT_IMG@; font-src 'self'; connect-src 'self' @ZT_CONNECT@; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'">
  <meta name="referrer" content="no-referrer">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="@ZT_DESCRIPTION@">
  <meta name="theme-color" content="@ZT_THEME_COLOR@">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="apple-mobile-web-app-title" content="@ZT_SHORT_NAME@">
  <link rel="apple-touch-icon" href="icons/Icon-192.png">
  <link rel="icon" type="image/png" href="favicon.png">
  <link rel="manifest" href="manifest.json">
  <title>@ZT_NAME@</title>
  <style>
    html, body { height: 100%; margin: 0; background: #F7F9FC; }
    #zt-loading {
      position: fixed; inset: 0; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 20px;
      font: 500 16px system-ui, -apple-system, "Segoe UI", sans-serif;
      color: #1B2430; background: #F7F9FC;
    }
    #zt-loading .ring {
      width: 36px; height: 36px; border-radius: 50%;
      border: 3px solid rgba(127, 127, 127, .25);
      border-top-color: @ZT_THEME_COLOR@;
      animation: zt-spin .9s linear infinite;
    }
    @keyframes zt-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { #zt-loading .ring { animation: none; } }
    @media (prefers-color-scheme: dark) {
      html, body, #zt-loading { background: #0E1116; }
      #zt-loading { color: #E6EAF0; }
    }
  </style>
</head>
<body>
  <div id="zt-loading" role="status" aria-live="polite">
    <div class="ring" aria-hidden="true"></div>
    <div>@ZT_NAME@</div>
    <noscript>This app needs JavaScript to decrypt your data in the browser.</noscript>
  </div>
  <script src="zt_boot.js"></script>
  <script src="flutter_bootstrap.js" async></script>
</body>
</html>
